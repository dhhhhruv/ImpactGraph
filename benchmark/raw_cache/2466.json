    "title": "Fix WiFi detection when wired connection is primary",
    "user": {
      "login": "CrazyTodd-one",
      "id": 263771835,
      "node_id": "U_kgDOD7jWuw",
      "avatar_url": "https://avatars.githubusercontent.com/u/263771835?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/CrazyTodd-one",
      "html_url": "https://github.com/CrazyTodd-one",
