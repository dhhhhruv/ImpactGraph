    {
      "sha": "372b294954a44585f8c6411324bb37a98cb31c24",
      "filename": "src/vorta/scheduler.py",
      "status": "modified",
      "additions": 1,
      "deletions": 1,
      "changes": 2,
      "blob_url": "https://github.com/borgbase/vorta/blob/0d452f778b6e247d6bb3ce6027c94a978c539bd8/src%2Fvorta%2Fscheduler.py",
      "raw_url": "https://github.com/borgbase/vorta/raw/0d452f778b6e247d6bb3ce6027c94a978c539bd8/src%2Fvorta%2Fscheduler.py",
      "contents_url": "https://api.github.com/repos/borgbase/vorta/contents/src%2Fvorta%2Fscheduler.py?ref=0d452f778b6e247d6bb3ce6027c94a978c539bd8",
      "patch": "@@ -214,9 +214,9 @@ def set_timer_for_profile(self, profile_id: int) -> None:\n         next suitable backup time.\n         \"\"\"\n         profile = BackupProfileModel.get_or_none(id=profile_id)\n-        logger.debug('Profile: %s, %d %d', str(profile), profile.schedule_fixed_hour, profile.schedule_fixed_minute)\n         if profile is None:  # profile doesn't exist any more.\n             return\n+        logger.debug('Profile: %s, %d %d', str(profile), profile.schedule_fixed_hour, profile.schedule_fixed_minute)\n \n         with self.lock:  # Acquire lock\n             self.remove_job(profile_id)  # reset schedule"
    },
