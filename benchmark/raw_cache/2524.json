    "title": "Fix crash in scheduler when profile no longer exists",
    "user": {
      "login": "SAY-5",
      "id": 240962040,
      "node_id": "U_kgDODlzJ-A",
      "avatar_url": "https://avatars.githubusercontent.com/u/240962040?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/SAY-5",
      "html_url": "https://github.com/SAY-5",
      "followers_url": "https://api.github.com/users/SAY-5/followers",
      "following_url": "https://api.github.com/users/SAY-5/following{/other_user}",
      "gists_url": "https://api.github.com/users/SAY-5/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/SAY-5/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/SAY-5/subscriptions",
      "organizations_url": "https://api.github.com/users/SAY-5/orgs",
      "repos_url": "https://api.github.com/users/SAY-5/repos",
      "events_url": "https://api.github.com/users/SAY-5/events{/privacy}",
      "received_events_url": "https://api.github.com/users/SAY-5/received_events",
