    "title": "Fix the metered networks checkbox so it saves and survives a restart",
    "user": {
      "login": "theluckystrike",
      "id": 51033404,
      "node_id": "MDQ6VXNlcjUxMDMzNDA0",
      "avatar_url": "https://avatars.githubusercontent.com/u/51033404?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/theluckystrike",
      "html_url": "https://github.com/theluckystrike",
      "followers_url": "https://api.github.com/users/theluckystrike/followers",
      "following_url": "https://api.github.com/users/theluckystrike/following{/other_user}",
      "gists_url": "https://api.github.com/users/theluckystrike/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/theluckystrike/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/theluckystrike/subscriptions",
      "organizations_url": "https://api.github.com/users/theluckystrike/orgs",
      "repos_url": "https://api.github.com/users/theluckystrike/repos",
      "events_url": "https://api.github.com/users/theluckystrike/events{/privacy}",
