    "title": "Fix non-ASCII (Korean) repo backup failure",
    "user": {
      "login": "GabrielDougherty",
      "id": 10541219,
      "node_id": "MDQ6VXNlcjEwNTQxMjE5",
      "avatar_url": "https://avatars.githubusercontent.com/u/10541219?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/GabrielDougherty",
      "html_url": "https://github.com/GabrielDougherty",
      "followers_url": "https://api.github.com/users/GabrielDougherty/followers",
      "following_url": "https://api.github.com/users/GabrielDougherty/following{/other_user}",
      "gists_url": "https://api.github.com/users/GabrielDougherty/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/GabrielDougherty/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/GabrielDougherty/subscriptions",
      "organizations_url": "https://api.github.com/users/GabrielDougherty/orgs",
      "repos_url": "https://api.github.com/users/GabrielDougherty/repos",
      "events_url": "https://api.github.com/users/GabrielDougherty/events{/privacy}",
